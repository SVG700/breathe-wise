# Breathe Wise — Powered by Prana (प्राण)
# Environment Configuration Template

# Google Gemini API Key for Prana AI Assistant
# Obtain your free or paid API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAQ v3 API Key for Real-Time Ground Monitoring Stations (CPCB India & Global)
# Obtain your free API key at: https://openaq.org/ (Account -> API Keys)
# If omitted or unconfigured, Breathe Wise gracefully falls back to Open-Meteo Copernicus model nodes.
OPENAQ_API_KEY=your_openaq_api_key_here

# Default Coordinates (Bengaluru, India)
NEXT_PUBLIC_DEFAULT_LAT=12.9716
NEXT_PUBLIC_DEFAULT_LON=77.5946
NEXT_PUBLIC_DEFAULT_CITY=Bengaluru
